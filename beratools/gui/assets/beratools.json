                {
                      "name": "Surface Water Mapping",
                      "info": "Map surface water from a true-colour orthomosaic: an rpart decision tree trained on random points in labelled polygons, an optional canopy height mask and removal of small water patches (Chan, Dabros & McDermid 2026, Forests 17, 489).",
                      "batch_processing": false,
                      "tool_type": "python",
                      "tool_api": "rpy_surface_water",
                      "icon": "",
                      "tech_link": "https://doi.org/10.3390/f17040489",
                      "parameters": [
