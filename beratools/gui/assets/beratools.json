                              "subtype": "float",
                              "default": 0.2,
                              "output": false,
                              "optional": true
                          },
                          {
                              "variable": "min_patch_area",
                              "label": "Minimum water patch area",
                              "description": "Water patches smaller than this area (m2) are removed. 0 keeps every patch.",
