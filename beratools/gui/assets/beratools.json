                              "subtype": "vector|polygon",
                              "default": "",
                              "output": false,
                              "optional": false
                          },
                          {
                              "variable": "out_folder",
                              "label": "Output folder",
                              "description": "Folder for surface_water.tif (1 water, 0 not water) and the cross-validation tables.",
